---
import '../styles/global.css';
import '../styles/hub-hero.css';
import '../styles/hub-closing.css';
import '../styles/learning-story.css';
import '../styles/hub-faq.css';
import { site, asset } from '../data/site';
interface Props {
  title?: string;
}
const { title = 'HubCSCA | 线下教学 + 线上工具，CSCA 全科备考' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#062c77" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/png" href={asset('images/hubcsca-logo.png')} />
    <link
      rel="preload"
      as="image"
      href={asset('images/hubcsca-scene-reference.png')}
      fetchpriority="high"
    />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳转到正文</a>
    <slot />
    <script>
      import '../scripts/home';
    </script>
  </body>
</html>
