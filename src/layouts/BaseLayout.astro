---
import '../styles/global.css';
import '../styles/hub-hero.css';
import '../styles/hub-closing.css';
import '../styles/learning-story.css';
import '../styles/hub-faq.css';
import { site, asset } from '../data/site';
import { localeFromUrl, pageUrl } from '../i18n/locale';
import '../styles/english.css';
const locale = localeFromUrl(Astro.url);
const page = Astro.url.pathname.includes('/resources') ? 'resources' : 'home';
interface Props {
  title?: string;
  description?: string;
  preloadHero?: boolean;
}
const {
  title = 'HubCSCA | 线下教学 + 线上工具，CSCA 全科备考',
  description = site.description,
  preloadHero = true,
} = Astro.props;
---

<!doctype html>
<html lang={locale === 'en' ? 'en' : 'zh-CN'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#062c77" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="alternate" hreflang="zh-CN" href={new URL(pageUrl(page, 'zh'), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(pageUrl(page, 'en'), Astro.site)} />
    <link rel="icon" type="image/png" href={asset('images/hubcsca-logo.png')} />
    {
      preloadHero && (
        <link
          rel="preload"
          as="image"
          href={asset('images/hubcsca-scene-reference.png')}
          fetchpriority="high"
        />
      )
    }
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳转到正文</a>
    <slot />
    <script>
      import '../scripts/home';
    </script>
  </body>
</html>
