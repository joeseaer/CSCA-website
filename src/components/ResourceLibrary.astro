---
import Icon from './Icon.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { asset, site } from '../data/site';
import { localeFromUrl, pageUrl } from '../i18n/locale';
import {
  syllabus,
  formulaGroups,
  glossaryGroups,
  appModules,
  resourceDownloads,
} from '../data/resources';
import '../styles/resources.css';

const categories = [
  { id: 'syllabus', label: '考试大纲' },
  { id: 'formulas', label: '数学公式' },
  { id: 'glossary', label: '双语术语' },
  { id: 'app', label: '小程序' },
];
const termCount = glossaryGroups.reduce((count, group) => count + group.terms.length, 0);
const formulaCount = formulaGroups.reduce((count, group) => count + group.formulas.length, 0);
const subjectSymbols: Record<string, string> = {
  mathematics: 'ƒ',
  'chinese-humanities': '文',
  'chinese-stem': '理',
  physics: 'λ',
  chemistry: 'H₂',
};
const formulaSymbols = ['∪', 'log', 'sin', '∑', 'ƒ′', 'π', 'i', 'P'];
const screens = [
  { id: 'home', title: '学习首页', file: 'home.webp' },
  { id: 'mock', title: '模拟考试', file: 'mock.webp' },
  { id: 'scan', title: '拍照搜题', file: 'scan.webp' },
  { id: 'note', title: '笔记详情', file: 'note-detail.webp' },
];
const moduleScreens: Record<string, string> = {
  home: 'home',
  exam: 'mock',
  camera: 'scan',
  notebook: 'note',
};
---

<SiteHeader current="resources" />
<main id="main" class="resource-library" data-library>
  <section class="resource-hero" id="top" aria-labelledby="resource-title">
    <div class="resource-hero-art" aria-hidden="true">
      <svg
        class="hero-coordinate"
        viewBox="0 0 1440 780"
        preserveAspectRatio="xMidYMid slice"
        fill="none"
      >
        <defs>
          <linearGradient
            id="resource-curve"
            x1="450"
            y1="650"
            x2="1400"
            y2="100"
            gradientUnits="userSpaceOnUse"
          >
            <stop stop-color="#00e3c4" stop-opacity=".15"></stop>
            <stop offset=".55" stop-color="#00e3c4"></stop>
            <stop offset="1" stop-color="#00bfea"></stop>
          </linearGradient>
          <pattern id="resource-grid" width="76" height="76" patternUnits="userSpaceOnUse">
            <path d="M76 0H0V76" stroke="#8dddf1" stroke-opacity=".12"></path>
          </pattern>
        </defs>
        <path fill="url(#resource-grid)" d="M0 0H1440V780H0Z"></path>
        <path d="M580 567H1440M1010 54V780" stroke="#91eaff" stroke-opacity=".4"></path>
        <path
          class="hero-wave-back"
          d="M420 681C700 664 730 239 962 279S1150 679 1500 148"
          stroke="#1f88e4"
          stroke-width="80"
          stroke-opacity=".2"></path>
        <path
          class="hero-wave-front"
          d="M420 681C700 664 730 239 962 279S1150 679 1500 148"
          stroke="url(#resource-curve)"
          stroke-width="3"
          pathLength="1"></path>
        <circle cx="962" cy="279" r="8" fill="#00e3c4"></circle>
        <circle
          class="hero-coordinate-pulse"
          cx="962"
          cy="279"
          r="23"
          stroke="#00e3c4"
          stroke-opacity=".5"></circle>
        <circle cx="1133" cy="470" r="5" fill="#c5fff6"></circle>
        <path d="m1415 557 15 10-15 10M1000 72l10-15 10 15" stroke="#91eaff" stroke-opacity=".6"
        ></path>
      </svg>
      <div class="hero-orbit hero-orbit-one"></div>
      <div class="hero-orbit hero-orbit-two"></div>
      <span class="hero-math hero-math-one">ƒ(x)</span>
      <span class="hero-math hero-math-two">∞</span>
      <span class="hero-math hero-math-three">∑</span>
    </div>
    <div class="resource-container resource-hero-content">
      <a class="resource-breadcrumb" href={pageUrl('home', localeFromUrl(Astro.url))}>
        <span>首页</span>
        <Icon name="right" size={14} />
        <span>资源库</span>
      </a>
      <h1 id="resource-title">
        <span class="hero-title-line">备考</span>
        <span class="hero-title-line hero-title-accent"
          >资源库<span class="hero-title-point">.</span></span
        >
      </h1>
      <nav class="hero-subjects" aria-label="资源快捷入口">
        {
          categories.map((category) => (
            <a href={`#${category.id}`}>
              <span>{category.label}</span>
              <Icon name="arrow" size={18} />
            </a>
          ))
        }
      </nav>
    </div>
    <a href="#collection" class="hero-scroll" aria-label="浏览资源"
      ><Icon name="down" size={23} /></a
    >
  </section>

  <div class="resource-container resource-collection" id="collection">
    <div class="resource-toolbar">
      <nav class="resource-categories" aria-label="资源分类">
        <a
          href="#collection"
          class="resource-category is-selected"
          data-category="all"
          aria-current="true">全部</a
        >
        {
          categories.map((category) => (
            <a href={`#${category.id}`} class="resource-category" data-category={category.id}>
              {category.label}
            </a>
          ))
        }
      </nav>
      <form class="resource-search" role="search" data-resource-search>
        <svg
          width="19"
          height="19"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m16 16 5 5"></path>
        </svg>
        <label for="resource-query" class="sr-only">搜索资源、公式与中英文术语</label>
        <input
          type="search"
          id="resource-query"
          name="q"
          placeholder="搜索资源"
          autocomplete="off"
        />
      </form>
    </div>
    <p class="resource-search-status" data-search-status role="status" aria-live="polite" hidden>
    </p>
    <div class="resource-empty" data-resource-empty hidden>
      <h2>没有找到相关资源</h2>
      <button type="button" data-clear-search>查看全部资源 <Icon name="arrow" size={18} /></button>
    </div>

    <section
      class="resource-section syllabus-section"
      id="syllabus"
      data-resource-section="syllabus"
      aria-labelledby="syllabus-title"
    >
      <div class="resource-section-heading" data-resource-reveal>
        <h2 id="syllabus-title">考试<span>大纲</span></h2>
        <span class="section-heading-symbol" aria-hidden="true">↗</span>
      </div>
      <div class="syllabus-directory">
        {
          syllabus.map((item) => (
            <article
              class="syllabus-row"
              data-resource-item
              data-resource-reveal
              data-search={[item.title, item.subject, item.description, ...item.topics].join(' ')}
            >
              <span class="syllabus-symbol" aria-hidden="true">
                {subjectSymbols[item.id]}
              </span>
              <div class="syllabus-name">
                <h3>{item.title.replace('考试大纲', '')}</h3>
                <p>{item.description}</p>
              </div>
              <div class="syllabus-topics">
                {item.topics.map((topic) => (
                  <span>{topic}</span>
                ))}
              </div>
              <a
                class="syllabus-download"
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`查看${item.title}`}
              >
                <span>{item.format}</span>
                <Icon name="arrow" size={25} />
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section
      class="resource-section formula-section"
      id="formulas"
      data-resource-section="formulas"
      aria-labelledby="formulas-title"
    >
      <div class="resource-section-heading" data-resource-reveal>
        <h2 id="formulas-title">数学<span>公式</span></h2>
        <span class="resource-section-meta">{formulaCount} 条公式</span>
      </div>
      <div class="formula-book">
        {
          formulaGroups.map((group, index) => (
            <article class="formula-chapter" data-resource-group data-resource-reveal>
              <div class="formula-chapter-heading">
                <h3>{group.title}</h3>
                <span aria-hidden="true">{formulaSymbols[index]}</span>
              </div>
              <div class="formula-list">
                {group.formulas.map((formula) => (
                  <div
                    class="formula-entry"
                    data-resource-item
                    data-search={`${group.title} ${formula.name} ${formula.expression} ${formula.note || ''}`}
                  >
                    <h4>{formula.name}</h4>
                    <p class="formula-expression">{formula.expression}</p>
                    {formula.note && <p class="formula-condition">{formula.note}</p>}
                  </div>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section
      class="resource-section glossary-section"
      id="glossary"
      data-resource-section="glossary"
      aria-labelledby="glossary-title"
    >
      <div class="glossary-heading-art" aria-hidden="true">中<span>⇄</span>英</div>
      <div class="resource-section-heading" data-resource-reveal>
        <h2 id="glossary-title">双语<span>术语</span></h2>
        <div class="resource-heading-actions">
          <span class="resource-section-meta">{termCount} 个词条</span>
          <a
            class="resource-download"
            href={asset(resourceDownloads.glossary.href.replace(/^\//, ''))}
            download
          >
            <Icon name="down" size={16} /><span>{resourceDownloads.glossary.format}</span>
          </a>
          <a
            class="resource-download"
            href={asset(resourceDownloads.glossaryCsv.href.replace(/^\//, ''))}
            download
          >
            <Icon name="down" size={16} /><span>{resourceDownloads.glossaryCsv.format}</span>
          </a>
        </div>
      </div>
      <div class="glossary-groups">
        {
          glossaryGroups.map((group) => (
            <details
              class="glossary-group"
              data-resource-group
              data-glossary-group
              open
              data-resource-reveal
            >
              <summary>
                <span class="glossary-group-title">
                  <>
                    <strong>{group.title}</strong>
                    <span>{group.terms.length}</span>
                  </>
                </span>
                <Icon name="plus" size={22} />
              </summary>
              <div
                class="glossary-table-wrap"
                tabindex="0"
                role="region"
                aria-label={`${group.title}对照表`}
              >
                <table class="glossary-table">
                  <thead>
                    <tr>
                      <>
                        <th scope="col">中文 · 符号</th>
                        <th scope="col">English</th>
                      </>
                    </tr>
                  </thead>
                  <tbody>
                    {group.terms.map((term) => (
                      <tr
                        data-resource-item
                        data-search={`${group.title} ${term.zh} ${term.en} ${term.pinyin} ${term.symbol} ${term.meaning}`}
                      >
                        <td lang="zh-CN">
                          {term.symbol && <span class="glossary-symbol">{term.symbol}</span>}
                          <span>{term.meaning || term.zh}</span>
                          {term.pinyin && <small class="glossary-pinyin">{term.pinyin}</small>}
                        </td>
                        <td lang="en">{term.en}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
          ))
        }
      </div>
    </section>

    <section
      class="resource-section app-section"
      id="app"
      data-resource-section="app"
      aria-labelledby="app-title"
    >
      <div class="resource-section-heading" data-resource-reveal>
        <h2 id="app-title">小程序<span>功能</span></h2>
        <a class="resource-open-app" href={site.platform} target="_blank" rel="noopener noreferrer"
          >打开 HubCSCA <Icon name="arrow" size={22} /></a
        >
      </div>
      <div class="app-theatre">
        <div class="app-stage" data-app-stage>
          <div class="app-stage-art" aria-hidden="true"><i></i><i></i><i></i><span>＋</span></div>
          <div class="app-stage-heading">
            <Icon name="sparkles" size={24} />
            <h3 data-stage-title>{appModules[0].title}</h3>
          </div>
          <div class="app-screen-stack">
            {
              screens.map((screen, index) => (
                <figure
                  class:list={['app-screen', { 'is-active': index === 0 }]}
                  data-stage-screen={screen.id}
                  aria-hidden={index !== 0 ? 'true' : undefined}
                >
                  <div class="app-screen-image" data-image-frame>
                    <div class="image-loading" aria-hidden="true">
                      <>
                        <i />
                        <i />
                        <i />
                        <i />
                      </>
                    </div>
                    <img
                      src={asset(`images/journey/${screen.file}`)}
                      alt={`HubCSCA ${screen.title}实际界面`}
                      width="390"
                      height="844"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <figcaption>{screen.title}</figcaption>
                </figure>
              ))
            }
            {
              appModules
                .filter((module) => !moduleScreens[module.id])
                .map((module) => (
                  <figure
                    class="app-screen app-concept"
                    data-stage-screen={module.id}
                    aria-hidden="true"
                  >
                    <Icon name={module.icon} size={160} />
                    <figcaption>
                      {module.features.map((feature) => (
                        <span>{feature}</span>
                      ))}
                    </figcaption>
                  </figure>
                ))
            }
          </div>
          <a
            class="app-stage-open"
            href={appModules[0].href}
            target="_blank"
            rel="noopener noreferrer"
            data-stage-open
          >
            <span>打开功能</span><Icon name="arrow" size={22} />
          </a>
        </div>
        <div class="app-directory">
          {
            appModules.map((module, index) => (
              <article
                class:list={['app-module-row', { 'is-active': index === 0 }]}
                data-resource-item
                data-module-row
                data-search={`${module.title} ${module.features.join(' ')}`}
              >
                <button
                  type="button"
                  class="app-module-select"
                  data-module-select
                  data-module-title={module.title}
                  data-module-screen={moduleScreens[module.id] || module.id}
                  data-module-href={module.href}
                  aria-pressed={index === 0 ? 'true' : 'false'}
                  disabled
                >
                  <span class="app-module-name">
                    <>
                      <Icon name={module.icon} size={24} />
                      <strong>{module.title}</strong>
                    </>
                  </span>
                  <span class="app-module-features">
                    {module.features.map((feature) => (
                      <span>{feature}</span>
                    ))}
                  </span>
                </button>
                <a
                  class="app-module-open"
                  href={module.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`打开${module.title}`}
                >
                  <Icon name="arrow" size={22} />
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</main>
<SiteFooter />
<script>
  import '../scripts/resources';
</script>
