---
import Icon from './Icon.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { asset, site } from '../data/site';
import {
  syllabus,
  formulaGroups,
  glossaryGroups,
  appModules,
  resourceDownloads,
} from '../data/resources';
import '../styles/resources.css';

const categories = [
  { id: 'syllabus', label: '考试大纲', icon: 'book' },
  { id: 'formulas', label: '数学公式', icon: 'chart' },
  { id: 'glossary', label: '双语术语', icon: 'globe' },
  { id: 'app', label: '小程序', icon: 'laptop' },
];
const termCount = glossaryGroups.reduce((count, group) => count + group.terms.length, 0);
const formulaCount = formulaGroups.reduce((count, group) => count + group.formulas.length, 0);
const subjectIcons: Record<string, string> = {
  mathematics: 'chart',
  'chinese-humanities': 'book',
  'chinese-stem': 'languages',
  physics: 'compass',
  chemistry: 'flask',
};
---

<SiteHeader current="resources" />
<main id="main" class="resource-library" data-library>
  <section class="resource-hero" id="top" aria-labelledby="resource-title">
    <div class="resource-hero-grid resource-container">
      <div class="resource-hero-copy">
        <a class="resource-breadcrumb" href={asset('')}
          ><span>首页</span><Icon name="right" size={13} />资源库</a
        >

        <h1 id="resource-title">备考<br /><em>资源库</em></h1>
        <p class="resource-hero-intro">考试大纲 · 数学公式 · 双语术语 · 学习工具</p>
        <a class="resource-hero-button" href="#collection"
          >探索资源库<Icon name="arrow" size={21} /></a
        >
      </div>
      <div class="resource-scene" aria-hidden="true">
        <div class="resource-orbit resource-orbit-one"></div>
        <div class="resource-orbit resource-orbit-two"></div>
        <div class="resource-orbit-dot"></div>
        <span class="scene-spark scene-spark-one">+</span><span class="scene-spark scene-spark-two"
          >✦</span
        >
        <div class="resource-paper paper-back"><span>中 / 英</span><i></i><i></i><i></i></div>
        <div class="resource-paper paper-main">
          <div class="paper-top"><span>HubCSCA</span></div>
          <div class="paper-rule"></div>

          <strong>数学公式</strong>
          <div class="paper-equation">a² + b² = c²</div>
          <svg class="paper-graph" viewBox="0 0 230 85" fill="none"
            ><path d="M10 73H220M31 6V78" stroke="#a9bdce"></path><path
              d="M15 22C65 100 100 100 160 26S204 15 218 8"
              stroke="#00a997"
              stroke-width="3"></path><circle cx="114" cy="65" r="4" fill="#00a997"></circle></svg
          >
        </div>
        <div class="scene-label scene-label-top">
          <span class="scene-label-icon"><Icon name="book" size={19} /></span><span>考试大纲</span
          ><Icon name="check" size={15} />
        </div>
        <div class="scene-label scene-label-bottom">
          <span class="scene-label-icon"><Icon name="globe" size={20} /></span><span
            >数学 × 语言</span
          >
        </div>
      </div>
    </div>
    <div class="resource-hero-bottom" aria-hidden="true"></div>
  </section>

  <div class="resource-container resource-collection" id="collection">
    <div class="resource-toolbar">
      <nav class="resource-categories" aria-label="资源分类">
        <a
          href="#collection"
          class="resource-category is-selected"
          data-category="all"
          aria-current="true">全部资源</a
        >
        {
          categories.map((category) => (
            <a href={`#${category.id}`} class="resource-category" data-category={category.id}>
              <Icon name={category.icon} size={17} />
              {category.label}
            </a>
          ))
        }
      </nav>
      <form class="resource-search" role="search" data-resource-search>
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
          ><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m16 16 5 5"></path></svg
        >
        <label for="resource-query" class="sr-only">搜索资源、公式与中英文术语</label>
        <input
          type="search"
          id="resource-query"
          name="q"
          placeholder="搜索资源、公式或术语"
          autocomplete="off"
        />
      </form>
    </div>
    <p class="resource-search-status" data-search-status role="status" aria-live="polite" hidden>
    </p>
    <div class="resource-empty" data-resource-empty hidden>
      <Icon name="book" size={34} /><h2>没有找到相关资源</h2><button type="button" data-clear-search
        >查看全部资源 <Icon name="arrow" size={17} /></button
      >
    </div>

    <section
      class="resource-section"
      id="syllabus"
      data-resource-section="syllabus"
      aria-labelledby="syllabus-title"
    >
      <div class="resource-section-heading" data-resource-reveal>
        <div>
          <h2 id="syllabus-title">
            考试大纲<span class="section-heading-dot">.</span>
          </h2>
        </div>
        <span class="resource-section-meta">科目范围与考试要求</span>
      </div>
      <div class="syllabus-grid">
        {
          syllabus.map((item, index) => (
            <article
              class="syllabus-card"
              data-resource-item
              data-resource-reveal
              data-search={[item.title, item.subject, item.description, ...item.topics].join(' ')}
              style={`--item-index:${index}`}
            >
              <div class="syllabus-card-top">
                <>
                  <span class="syllabus-icon">
                    <Icon name={subjectIcons[item.id] || 'book'} size={25} />
                  </span>
                  <span class="resource-file-type">{item.format}</span>
                </>
              </div>
              <>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </>
              <div class="resource-topic-list">
                {item.topics.map((topic) => (
                  <span>{topic}</span>
                ))}
              </div>
              <a
                class="resource-card-link"
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                <>
                  <span>查看大纲</span>
                  <span class="resource-circle-arrow">
                    <Icon name="arrow" size={18} />
                  </span>
                </>
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section
      class="resource-section"
      id="formulas"
      data-resource-section="formulas"
      aria-labelledby="formulas-title"
    >
      <div class="resource-section-heading" data-resource-reveal>
        <div>
          <h2 id="formulas-title">
            常用数学公式<span class="section-heading-dot">.</span>
          </h2>
        </div><span class="resource-section-meta">{formulaCount} 条公式</span>
      </div>
      <div class="formula-grid">
        {
          formulaGroups.map((group, index) => (
            <article
              class="formula-card"
              data-resource-group
              data-resource-reveal
              style={`--item-index:${index % 3}`}
            >
              <div class="formula-group-heading">
                <>
                  <h3>{group.title}</h3>
                  <span class="formula-group-symbol" aria-hidden="true">
                    {['ƒ', '∑', '△', 'π', 'P', '∞', 'x²', '∫'][index % 8]}
                  </span>
                </>
              </div>
              <div class="formula-list">
                {group.formulas.map((formula) => (
                  <div
                    class="formula-entry"
                    data-resource-item
                    data-search={`${group.title} ${formula.name} ${formula.expression} ${formula.note || ''}`}
                  >
                    <h4>{formula.name}</h4>
                    <p class="formula-expression">{formula.expression}</p>
                    {formula.note && <p class="formula-condition">{formula.note}</p>}
                  </div>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section
      class="resource-section"
      id="glossary"
      data-resource-section="glossary"
      aria-labelledby="glossary-title"
    >
      <div class="resource-section-heading" data-resource-reveal>
        <div>
          <h2 id="glossary-title">
            翻译术语对照表<span class="section-heading-dot">.</span>
          </h2>
        </div><div class="resource-heading-actions">
          <span class="resource-section-meta">{termCount} 个词条</span>{
            resourceDownloads.glossary && (
              <a
                class="resource-download"
                href={asset(resourceDownloads.glossary.href.replace(/^\//, ''))}
                download
              >
                <Icon name="down" size={16} />
                {resourceDownloads.glossary.format}
              </a>
            )
          }{
            resourceDownloads.glossaryCsv && (
              <a
                class="resource-download"
                href={asset(resourceDownloads.glossaryCsv.href.replace(/^\//, ''))}
                download
              >
                <Icon name="down" size={16} />
                {resourceDownloads.glossaryCsv.format}
              </a>
            )
          }
        </div>
      </div>
      <div class="glossary-layout">
        <aside class="glossary-note" data-resource-reveal>
          <div class="glossary-letter" aria-hidden="true">
            <span>数</span><span>ƒ</span>
          </div><h3>中英数学词汇</h3><div class="glossary-note-example">
            <span>函数</span><span>function <Icon name="arrow" size={16} /></span>
          </div>
        </aside>
        <div class="glossary-groups">
          {
            glossaryGroups.map((group, index) => (
              <details
                class="glossary-group"
                data-resource-group
                data-glossary-group
                open={index === 0}
                data-resource-reveal
              >
                <>
                  <summary>
                    <>
                      <span class="glossary-group-title">
                        <>
                          <h3>{group.title}</h3>
                          <span class="glossary-count">{group.terms.length}</span>
                        </>
                      </span>
                      <span class="glossary-expand">
                        <Icon name="plus" size={19} />
                      </span>
                    </>
                  </summary>
                  <div
                    class="glossary-table-wrap"
                    tabindex="0"
                    role="region"
                    aria-label={`${group.title}对照表`}
                  >
                    <table class="glossary-table">
                      <>
                        <thead>
                          <tr>
                            <>
                              <th scope="col">中文 · 符号</th>
                              <th scope="col">English</th>
                            </>
                          </tr>
                        </thead>
                        <tbody>
                          {group.terms.map((term) => (
                            <tr
                              data-resource-item
                              data-search={`${group.title} ${term.zh} ${term.en} ${term.pinyin} ${term.symbol} ${term.meaning}`}
                            >
                              <td lang="zh-CN">
                                {term.symbol && <span class="glossary-symbol">{term.symbol}</span>}
                                <span>{term.meaning || term.zh}</span>
                                {term.pinyin && (
                                  <small class="glossary-pinyin">{term.pinyin}</small>
                                )}
                              </td>
                              <td lang="en">{term.en}</td>
                            </tr>
                          ))}
                        </tbody>
                      </>
                    </table>
                  </div>
                </>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section
      class="resource-section resource-app-section"
      id="app"
      data-resource-section="app"
      aria-labelledby="app-title"
    >
      <div class="resource-section-heading" data-resource-reveal>
        <div>
          <h2 id="app-title">
            小程序功能<span class="section-heading-dot">.</span>
          </h2>
        </div><a
          class="resource-open-app"
          href={site.platform}
          target="_blank"
          rel="noopener noreferrer">进入在线学习 <Icon name="arrow" size={19} /></a
        >
      </div>
      <div class="resource-app-showcase" data-resource-reveal>
        <div class="app-showcase-copy">
          <h3>HubCSCA<br />学习工具</h3><div class="app-showcase-pills">
            <span>理解</span><i></i><span>练习</span><i></i><span>复盘</span>
          </div><a
            href={site.platform}
            class="resource-hero-button"
            target="_blank"
            rel="noopener noreferrer">打开 HubCSCA <Icon name="arrow" size={19} /></a
          >
        </div>
        <div class="app-showcase-visual">
          <div class="app-showcase-orbit" aria-hidden="true"></div><figure
            class="resource-phone"
            data-image-frame
          >
            <div class="phone-speaker" aria-hidden="true"></div><div
              class="image-loading"
              aria-hidden="true"
            >
              <i></i><i></i><i></i><i></i>
            </div><img
              src={asset('images/journey/home.webp')}
              alt="HubCSCA 小程序首页，包含学习工具与备考功能入口"
              width="390"
              height="844"
              loading="lazy"
              decoding="async"
            /><figcaption class="sr-only">小程序首页</figcaption>
          </figure><span class="app-visual-badge app-badge-first"
            ><Icon name="camera" size={18} />拍照搜题</span
          ><span class="app-visual-badge app-badge-last"
            ><Icon name="layers" size={18} />专项训练</span
          >
        </div>
      </div>
      <div class="app-module-grid">
        {
          appModules.map((module, index) => (
            <article
              class="app-module"
              data-resource-item
              data-resource-reveal
              data-search={`${module.title} ${module.description} ${module.features.join(' ')}`}
              style={`--item-index:${index % 3}`}
            >
              <div class="app-module-top">
                <span class="app-module-icon">
                  <Icon name={module.icon} size={24} />
                </span>
              </div>
              <h3>{module.title}</h3>
              <p>{module.description}</p>
              <div class="app-module-features">
                {module.features.map((feature) => (
                  <span>{feature}</span>
                ))}
              </div>
              {module.href && (
                <a
                  class="app-module-link"
                  href={module.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`打开${module.title}`}
                >
                  <Icon name="arrow" size={19} />
                </a>
              )}
            </article>
          ))
        }
      </div>
    </section>
    <div class="resource-end-mark" aria-hidden="true">
      <span></span><Icon name="books" size={20} /><span></span>
    </div>
  </div>
</main>
<SiteFooter />
<script>
  import '../scripts/resources';
</script>
