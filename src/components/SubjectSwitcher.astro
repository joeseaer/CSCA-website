---
import { localeFromUrl } from '../i18n/locale';
import '../styles/subjects.css';

const en = localeFromUrl(Astro.url) === 'en';
const subjects = [
  { id: 'math', label: en ? 'Math' : '数学' },
  { id: 'physics', label: en ? 'Physics' : '物理' },
  { id: 'chemistry', label: en ? 'Chemistry' : '化学' },
  { id: 'chinese', label: en ? 'Chinese' : '专业中文' },
];
---

<div class="subject-switcher" id="subjects" data-subject-switcher>
  <div
    class="subject-options"
    role="group"
    aria-label={en ? 'Subjects' : '科目'}
    data-subject-options
  >
    {
      subjects.map((subject, index) => (
        <button
          type="button"
          aria-pressed={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
          data-subject={subject.id}
        >
          {subject.label}
        </button>
      ))
    }
  </div>
</div>

<script>
  import '../scripts/subjects';
</script>
