{
  "name": "csca-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-astro.mjs dev --host 127.0.0.1",
    "build": "node scripts/run-astro.mjs build && node scripts/check-static.mjs",
    "preview": "node scripts/run-astro.mjs preview --host 127.0.0.1",
    "check": "node scripts/run-astro.mjs check",
    "format": "prettier --write src scripts *.mjs *.json README.md .prettierrc.json",
    "format:check": "prettier --check src scripts *.mjs *.json README.md .prettierrc.json"
  },
  "dependencies": {
    "astro": "7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "parse5": "8.1.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3"
  },
  "description": "HubCSCA Chinese and English static website frontend",
  "engines": {
    "node": ">=22.23.4",
    "npm": ">=9.6.5"
  }
}
